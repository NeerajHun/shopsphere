
{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../../",
  "testRegex": "apps/auth-service/test/.*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json",
        "useESM": false
      }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@common/common(|/.*)$": "<rootDir>/libs/common/src/$1",
    "^@contracts/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1"
  },
  "testTimeout": 30000,
  "maxWorkers": 1
}
