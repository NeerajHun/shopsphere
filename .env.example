NODE_ENV=development
API_GATEWAY_PORT=3000

JWT_SECRET=replace-with-a-secure-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret
JWT_REFRESH_EXPIRY=7d

LOG_LEVEL=info
# PostgreSQL
POSTGRES_ADMIN_PASSWORD=replace-with-secure-local-password
AUTH_DB_PASSWORD=replace-with-secure-password
PRODUCT_DB_PASSWORD=replace-with-secure-password
ORDER_DB_PASSWORD=replace-with-secure-password
INVENTORY_DB_PASSWORD=replace-with-secure-password
PAYMENT_DB_PASSWORD=replace-with-secure-password
SHIPPING_DB_PASSWORD=replace-with-secure-password
NOTIFICATION_DB_PASSWORD=replace-with-secure-password

# RabbitMQ
RABBITMQ_DEFAULT_USER=shopsphere
RABBITMQ_DEFAULT_PASS=replace-with-secure-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-secure-password

# ==========================================
# PostgreSQL Service Connections
# ==========================================

# Auth Service
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user

# Product Service
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5433
PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_user

# Order Service
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5433
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user

# Inventory Service
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5433
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user

# Payment Service
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5433
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user

# Shipping Service
SHIPPING_DB_HOST=localhost
SHIPPING_DB_PORT=5433
SHIPPING_DB_NAME=shipping_db
SHIPPING_DB_USER=shipping_user

# Notification Service
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5433
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user

# ==========================================
# RabbitMQ
# ==========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

AUTH_SERVICE_PORT=3001
